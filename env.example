# Copiez ce fichier en « .env » (jamais « .env » dans Git) puis adaptez les valeurs.
# Sans aucune clé, l'application fonctionne en mode démonstration.

SECRET_KEY=changez-moi
# FLASK_DEBUG=1
# PORT=5000

# Fournisseur de l'assistant : demo | anthropic | openai
LLM_PROVIDER=demo
# Modèle (optionnel ; sinon valeur par défaut du fournisseur)
# LLM_MODEL=

# Clés API : lues uniquement côté serveur
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # ou tout service compatible

# Réglages RAG
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.08
# LLM_TIMEOUT=30
